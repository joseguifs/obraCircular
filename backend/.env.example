OBRA_CIRCULAR_APP_NAME=Obra Circular API
OBRA_CIRCULAR_ENVIRONMENT=local
OBRA_CIRCULAR_DEBUG=true
OBRA_CIRCULAR_API_V1_PREFIX=/api/v1
OBRA_CIRCULAR_CORS_ORIGINS=["http://localhost:5173"]
OBRA_CIRCULAR_DATABASE_URL=postgresql+asyncpg://SEU_USUARIO:SUA_SENHA@localhost:5432/obra_circular_web
OBRA_CIRCULAR_JWT_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
OBRA_CIRCULAR_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
OBRA_CIRCULAR_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OBRA_CIRCULAR_STORAGE_PATH=storage
OBRA_CIRCULAR_MAX_AD_IMAGES=5
OBRA_CIRCULAR_MAX_IMAGE_SIZE_BYTES=5242880
OBRA_CIRCULAR_FRONTEND_URL=http://localhost:5173
OBRA_CIRCULAR_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# SMTP para envio de e-mails (recuperação de senha). Com o Gmail, use smtp.gmail.com
# e uma "senha de app" da conta do sistema em OBRA_CIRCULAR_SMTP_PASSWORD.
# Com OBRA_CIRCULAR_SMTP_HOST vazio, os e-mails são apenas exibidos no log do backend.
OBRA_CIRCULAR_SMTP_HOST=
OBRA_CIRCULAR_SMTP_PORT=587
OBRA_CIRCULAR_SMTP_SECURITY=starttls
OBRA_CIRCULAR_SMTP_USERNAME=conta-do-sistema@gmail.com
OBRA_CIRCULAR_SMTP_PASSWORD=senha-de-app-de-16-caracteres
OBRA_CIRCULAR_SMTP_FROM_EMAIL=conta-do-sistema@gmail.com
OBRA_CIRCULAR_SMTP_FROM_NAME=Obra Circular

# Mercado Pago Marketplace / Checkout Pro
# Em desenvolvimento, use a URL HTTPS do ngrok tanto no painel quanto nestes campos.
OBRA_CIRCULAR_MP_CLIENT_ID=
OBRA_CIRCULAR_MP_CLIENT_SECRET=
# Use aqui a assinatura do webhook configurada no modo de teste da aplicacao.
OBRA_CIRCULAR_MP_WEBHOOK_SECRET_TEST=
# Assinatura da aplicacao principal usada em producao.
OBRA_CIRCULAR_MP_WEBHOOK_SECRET_PRODUCTION=
# Fallback opcional para instalacoes que recebem apenas um dos ambientes.
OBRA_CIRCULAR_MP_WEBHOOK_SECRET=
# Gere uma chave aleatoria com pelo menos 32 caracteres e nao a versione.
OBRA_CIRCULAR_MP_TOKEN_ENCRYPTION_KEY=
OBRA_CIRCULAR_MP_PUBLIC_BASE_URL=https://SEU_SUBDOMINIO.ngrok-free.app
OBRA_CIRCULAR_MP_OAUTH_REDIRECT_URI=https://SEU_SUBDOMINIO.ngrok-free.app/api/v1/integrations/mercado-pago/oauth/callback
OBRA_CIRCULAR_MP_OAUTH_TEST_TOKEN=false
OBRA_CIRCULAR_MP_LIVE_MODE=false
OBRA_CIRCULAR_MP_WEBHOOK_URL=https://SEU_SUBDOMINIO.ngrok-free.app/api/v1/webhooks/mercado-pago
OBRA_CIRCULAR_MP_OAUTH_SUCCESS_URL=http://localhost:5173/perfil/mercado-pago?mercado_pago=conectado
OBRA_CIRCULAR_MP_CHECKOUT_SUCCESS_URL=http://localhost:5173/pagamento/retorno?status=success
OBRA_CIRCULAR_MP_CHECKOUT_PENDING_URL=http://localhost:5173/pagamento/retorno?status=pending
OBRA_CIRCULAR_MP_CHECKOUT_FAILURE_URL=http://localhost:5173/pagamento/retorno?status=failure
OBRA_CIRCULAR_MARKETPLACE_FEE_PERCENT=25.00
OBRA_CIRCULAR_STOCK_RESERVATION_MINUTES=30
OBRA_CIRCULAR_WEBHOOK_RETRY_MAX_ATTEMPTS=8
OBRA_CIRCULAR_WEBHOOK_RETRY_BASE_SECONDS=30
OBRA_CIRCULAR_WEBHOOK_RETRY_MAX_SECONDS=3600
OBRA_CIRCULAR_WEBHOOK_PROCESSING_LEASE_SECONDS=120
OBRA_CIRCULAR_WEBHOOK_RETRY_BATCH_SIZE=100
OBRA_CIRCULAR_WEBHOOK_WORKER_ENABLED=true
OBRA_CIRCULAR_WEBHOOK_WORKER_INTERVAL_SECONDS=30
